# ============================================================
# WACRM — Insurance WhatsApp Inbox Edition
# Environment Variables Configuration
#
# IMPORTANT:
# - All Meta credentials are strictly server-side (never exposed to browser).
# - Do not commit real credentials, tokens, or secrets to version control.
# ============================================================

# ------------------------------------------------------------
# 1. Meta WhatsApp Cloud API (Server-Side)
# ------------------------------------------------------------
# System User Access Token from Meta Business Manager (Permanent Token)
META_ACCESS_TOKEN=EAAG...your_permanent_system_user_token_here

# WhatsApp Phone Number ID (From WhatsApp → API Setup)
META_PHONE_NUMBER_ID=100000000000000

# WhatsApp Business Account ID (WABA ID)
META_WABA_ID=200000000000000

# Meta App Secret (From Meta for Developers → App Settings → Basic)
# Used for HMAC-SHA256 webhook signature verification.
META_APP_SECRET=0123456789abcdef0123456789abcdef

# Webhook Verification Token (Secret string you define for Meta webhook challenge)
META_WEBHOOK_VERIFY_TOKEN=your_secure_random_webhook_verify_token_here

# Meta Graph API Version (defaults to v22.0)
META_GRAPH_API_VERSION=v22.0

# ------------------------------------------------------------
# 2. Application & Database (Neon PostgreSQL Project B)
# ------------------------------------------------------------
# Neon PostgreSQL Connection String (Pooler or direct URL)
# Execute `neon_schema.sql` on your Neon database before booting the app.
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Base URL of this WACRM deployment (Netlify production URL or local ngrok tunnel)
WACRM_APP_URL=https://insurance-whatsapp.netlify.app

# Server-Side Service API Key for Machine-to-Machine communication (FastAPI -> WACRM)
# Used in Authorization: Bearer <WACRM_SERVICE_API_KEY> for POST /api/v1/messages
WACRM_SERVICE_API_KEY=wacrm_live_insurance_secret_api_key_32chars
WACRM_API_KEY=wacrm_live_insurance_secret_api_key_32chars

# Encryption key for legacy payload security (64 hex characters = 32 bytes AES-256)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------
# 3. Clerk Authentication
# ------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...your_publishable_key
CLERK_SECRET_KEY=sk_test_...your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/inbox
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/inbox

# ------------------------------------------------------------
# 4. Application A (Insurance FastAPI Backend) Integration
# ------------------------------------------------------------
# Base URL of your deployed or local FastAPI insurance management application
FASTAPI_BASE_URL=https://insurance-backend.onrender.com

# Service Token for authenticated server-to-server calls to FastAPI (/api/v1/integrations/*)
FASTAPI_SERVICE_TOKEN=insurance_service_token_secret_value

# Outbound SSRF Guard Allowlist (Comma-separated hostnames allowed for workflow HTTP requests)
WORKFLOW_ALLOWED_HOSTS=insurance-backend.onrender.com,localhost,127.0.0.1

# ------------------------------------------------------------
# 5. Scheduled Flow Wait Step Pinger (Netlify Cron / External)
# ------------------------------------------------------------
# Secret token protecting POST /api/flows/cron
FLOW_CRON_SECRET=your_random_cron_secret_string
