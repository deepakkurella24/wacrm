{
  "name": "Insurance Policy & Renewal Reminder",
  "description": "Triggered by 'POLICY' or 'RENEW' keyword. Calls FastAPI integration API to fetch customer policy details, parses due date and premium, sends WhatsApp reminder with payment link, and routes payment confirmations to the agent.",
  "trigger_type": "keyword",
  "trigger_config": {
    "keywords": ["POLICY", "RENEW", "INSURANCE", "RENEWAL"],
    "match_type": "contains",
    "case_sensitive": false
  },
  "nodes": [
    {
      "node_key": "start",
      "node_type": "start",
      "config": {
        "next_node_key": "node_fetch_policy"
      },
      "position_x": 100,
      "position_y": 100
    },
    {
      "node_key": "node_fetch_policy",
      "node_type": "api_request",
      "config": {
        "method": "GET",
        "url": "{{vars.FASTAPI_BASE_URL}}/api/v1/integrations/policy?phone={{contact.phone}}",
        "headers": {
          "Accept": "application/json"
        },
        "response_mapping": {
          "policy_number": "policy_number",
          "vehicle_number": "vehicle_number",
          "due_date": "due_date",
          "balance_due": "balance_due",
          "payment_link": "payment_link",
          "is_paid": "is_paid"
        },
        "timeout_ms": 10000,
        "success_next": "node_check_paid",
        "failure_next": "node_lookup_failed"
      },
      "position_x": 300,
      "position_y": 100
    },
    {
      "node_key": "node_check_paid",
      "node_type": "condition",
      "config": {
        "subject": "var",
        "subject_key": "is_paid",
        "operator": "equals",
        "value": "true",
        "true_next": "node_already_paid",
        "false_next": "node_send_reminder"
      },
      "position_x": 550,
      "position_y": 100
    },
    {
      "node_key": "node_already_paid",
      "node_type": "send_message",
      "config": {
        "text": "Hello {{contact.name}}, your policy {{vars.policy_number}} for vehicle {{vars.vehicle_number}} is already active and up to date. Thank you!",
        "next_node_key": "node_end"
      },
      "position_x": 800,
      "position_y": 50
    },
    {
      "node_key": "node_send_reminder",
      "node_type": "send_buttons",
      "config": {
        "text": "Dear {{contact.name}},\n\nYour vehicle insurance policy is due for renewal:\n• Vehicle: {{vars.vehicle_number}}\n• Policy No: {{vars.policy_number}}\n• Due Date: {{vars.due_date}}\n• Balance Due: ₹{{vars.balance_due}}\n\nPay online securely here:\n{{vars.payment_link}}\n\nPlease let us know if you need any assistance.",
        "buttons": [
          {
            "reply_id": "paid_confirm",
            "title": "I have paid",
            "next_node_key": "node_payment_notified"
          },
          {
            "reply_id": "request_agent",
            "title": "Talk to Agent",
            "next_node_key": "node_agent_handoff"
          }
        ]
      },
      "position_x": 800,
      "position_y": 200
    },
    {
      "node_key": "node_payment_notified",
      "node_type": "send_message",
      "config": {
        "text": "Thank you! We have notified your insurance advisor. Your updated policy document will be shared once payment verification completes.",
        "next_node_key": "node_end"
      },
      "position_x": 1100,
      "position_y": 150
    },
    {
      "node_key": "node_lookup_failed",
      "node_type": "send_message",
      "config": {
        "text": "Hello, we could not find an active policy for this phone number. Connecting you with our insurance team now...",
        "next_node_key": "node_agent_handoff"
      },
      "position_x": 550,
      "position_y": 300
    },
    {
      "node_key": "node_agent_handoff",
      "node_type": "handoff",
      "config": {
        "note": "Customer contacted WhatsApp regarding policy renewal."
      },
      "position_x": 1100,
      "position_y": 300
    },
    {
      "node_key": "node_end",
      "node_type": "end",
      "config": {},
      "position_x": 1350,
      "position_y": 150
    }
  ]
}
